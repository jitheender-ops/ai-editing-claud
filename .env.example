# Copy to .env (which is gitignored) or, better, store these in the macOS keychain:
#
#   security add-generic-password -s "ave:GEMINI_API_KEY" -a "$USER" -w
#
# ave/config.py reads the environment first, then the keychain. Nothing here is
# required for ingest, proxies, `ave doctor`, or any local analysis.

# Planner LLM. Google AI Studio has a genuinely free tier, which is why it is the
# default — the planner should cost nothing to run.
GEMINI_API_KEY=

# Optional alternative provider.
ANTHROPIC_API_KEY=

# Debug mode: one JSON object per log line instead of human-readable output.
AVE_LOG_JSON=0
